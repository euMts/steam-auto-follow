{
  "manifest_version": 3,
  "name": "Giveaway.su Copy Actions",
  "version": "1.2.0",
  "description": "Copia URLs e verifica todas as tasks do giveaway.su.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://giveaway.su/giveaway/view/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
